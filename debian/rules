#!/usr/bin/make -f

# Launchpad's PPA builders have no network access and Ubuntu's own rustc is
# older than this code needs (edition 2024), so a pinned Rust toolchain and
# every crate Cargo.lock resolves to are vendored under packaging/vendor/
# (see packaging/vendor/README) and unpacked into build-scoped directories.
RUST_VERSION := 1.97.1
RUST_TRIPLE := x86_64-unknown-linux-gnu
VENDOR := $(CURDIR)/packaging/vendor
RUST_ROOT := $(CURDIR)/debian/.rust

export HOME := $(CURDIR)/debian/.home
export CARGO_HOME := $(CURDIR)/debian/.cargo
export PATH := $(RUST_ROOT)/bin:$(PATH)
export CARGO_TERM_COLOR := never
# Reproducible paths in panics/debug info.
export RUSTFLAGS := --remap-path-prefix=$(CURDIR)=/build/gearwise

%:
	dh $@

override_dh_auto_configure:
	mkdir -p $(HOME) $(CARGO_HOME)
	cd $(VENDOR) && sha256sum -c SHA256SUMS
	if [ ! -x "$(RUST_ROOT)/bin/cargo" ]; then \
		set -e; tmp=$$(mktemp -d); \
		for c in rustc cargo rust-std; do \
			tar --no-same-owner -xJf $(VENDOR)/$$c-$(RUST_VERSION)-$(RUST_TRIPLE).tar.xz -C $$tmp; \
			$$tmp/$$c-$(RUST_VERSION)-$(RUST_TRIPLE)/install.sh \
				--prefix=$(RUST_ROOT) --disable-ldconfig --without=rust-docs >/dev/null; \
		done; \
		rm -rf $$tmp; \
	fi
	if [ ! -d "$(CURDIR)/vendor" ]; then \
		tar --no-same-owner -xJf $(VENDOR)/crates-0.1.0.tar.xz -C $(CURDIR); \
	fi
	printf '[source.crates-io]\nreplace-with = "vendored"\n[source.vendored]\ndirectory = "%s/vendor"\n[net]\noffline = true\n' \
		"$(CURDIR)" > $(CARGO_HOME)/config.toml

override_dh_auto_build:
	cargo build --release --frozen --offline -p gearwise

# Driver and UI tests run in upstream CI; they need no hardware but pull in
# dev-dependencies that are not vendored.
override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 target/release/gearwise debian/gearwise/usr/bin/gearwise
	install -Dm644 packaging/linux/gearwise.desktop \
		debian/gearwise/usr/share/applications/gearwise.desktop
	for s in 16 32 48 64 128 256 512; do \
		install -Dm644 packaging/icons/gearwise-$$s.png \
			debian/gearwise/usr/share/icons/hicolor/$${s}x$${s}/apps/gearwise.png; \
	done

# Must sort before 73-seat-late.rules, which turns TAG+="uaccess" into ACLs.
override_dh_installudev:
	dh_installudev --priority=70

override_dh_auto_clean:
	rm -rf target vendor debian/.rust debian/.cargo debian/.home
