# Maintainer: Dhiva Labs <dhivakar1010@gmail.com>
#
# AUR package. It repackages the .deb from the GitHub release, so Arch users
# run the same build as every other distribution. packaging/arch/aur.sh
# renders this file for each release (version and checksums) and checks it
# with makepkg; the rendered PKGBUILD, .SRCINFO and gearwise.install are what
# gets pushed to the AUR.
pkgname=@NAME@-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='@SUMMARY@'
arch=('x86_64' 'aarch64')
url='@HOMEPAGE@'
license=('@LICENSE@')
# The display and GL libraries are dlopen()ed by the binary, so they are
# listed by hand, like the .deb's Depends.
depends=(@ARCH_DEPENDS@)
provides=('@NAME@')
conflicts=('@NAME@')
options=('!strip' '!debug')
# Reloads udev so the rule in /usr/lib/udev/rules.d applies to devices that
# are already plugged in.
install=@NAME@.install
source_x86_64=("@RELEASE_URL@/@DEB_AMD64@")
source_aarch64=("@RELEASE_URL@/@DEB_ARM64@")
sha256sums_x86_64=('@SHA_AMD64@')
sha256sums_aarch64=('@SHA_ARM64@')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  # The .deb keeps the licence as Debian's copyright file.
  install -Dm644 "$pkgdir/usr/share/doc/@NAME@/copyright" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
