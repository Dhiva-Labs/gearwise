# Reload the udev rules and re-apply them to the hidraw and uinput nodes that
# already exist, so plugged-in devices work without a replug (as the .deb's
# postinst does). Without a running udev there is nothing to reload.
_reload() {
  if command -v udevadm > /dev/null 2>&1; then
    udevadm control --reload-rules 2> /dev/null || :
    udevadm trigger --subsystem-match=hidraw --subsystem-match=misc 2> /dev/null || :
  fi
}

post_install() {
  _reload
}

post_upgrade() {
  _reload
}

post_remove() {
  _reload
}
