# Periph Studio: let the user logged in at the console configure their mice
# and keyboards without running as root.
#
# Install with packaging/linux/install-udev-rules.sh (copies this file to
# /etc/udev/rules.d/). The "70-" prefix is deliberate: TAG+="uaccess" is turned
# into a per-user ACL by 73-seat-late.rules, so this file must sort before it.
#
# Vendors: 046d Logitech, 1532 Razer, 1b1c Corsair, 1038 SteelSeries.

# Nothing to do when a node goes away.
ACTION=="remove", GOTO="periph_studio_end"

# --- HID configuration interfaces (/dev/hidraw*) ------------------------------
SUBSYSTEM!="hidraw", GOTO="periph_studio_uinput"
KERNEL!="hidraw*", GOTO="periph_studio_uinput"

# USB: the idVendor attribute lives on the parent usb_device.
ATTRS{idVendor}=="046d", GOTO="periph_studio_hidraw_apply"
ATTRS{idVendor}=="1532", GOTO="periph_studio_hidraw_apply"
ATTRS{idVendor}=="1b1c", GOTO="periph_studio_hidraw_apply"
ATTRS{idVendor}=="1038", GOTO="periph_studio_hidraw_apply"

# Bluetooth (bus 0005) and Logitech receivers' paired devices: the parent HID
# device is named BUS:VID:PID.INSTANCE with upper-case hex.
KERNELS=="0005:046D:*", GOTO="periph_studio_hidraw_apply"
KERNELS=="0005:1532:*", GOTO="periph_studio_hidraw_apply"
KERNELS=="0005:1B1C:*", GOTO="periph_studio_hidraw_apply"
KERNELS=="0005:1038:*", GOTO="periph_studio_hidraw_apply"
GOTO="periph_studio_uinput"

LABEL="periph_studio_hidraw_apply"
TAG+="uaccess"

# --- Macro playback: synthetic keyboard/mouse events via /dev/uinput ----------
# static_node lets udev create and tag the node (and autoload the module) even
# before the uinput module has been loaded.
LABEL="periph_studio_uinput"
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"

LABEL="periph_studio_end"
